{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "sourceMap": true,
    "strict": true,
    "types": ["$app/types", "vite/client", "node"]
  },
  "include": ["src/**/*.d.ts", "src/**/*.js", "src/**/*.svelte"],
  "exclude": ["src/service-worker"]
}
